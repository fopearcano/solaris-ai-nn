# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / cache
.pytest_cache/
.coverage
htmlcov/

# Experiment output (JSONL telemetry/traces)
*.jsonl
# ...but the bundled example fixtures are committed for reproducibility.
!examples/live_observation/*.jsonl
!examples/live_ontogenesis/*.jsonl
!examples/live_cognition/*.jsonl
!examples/environmental_membrane/*.jsonl
!examples/membrane_integration/**/*.jsonl
!examples/tester_fixture_spine/**/*.jsonl
!examples/tester_live_readonly/**/*.jsonl
runs/
artifacts/

# Persistent runtime state (manifests, checkpoints, continuity logs, traces).
# A running "brain" lives here; it is reproducible from code and must not be committed.
.solaris_ai_nn_state/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Benchmark runtime output (manifests, results, artifacts). Reproducible from code.
.solaris_ai_nn_benchmarks/

# Operations output (health logs, incidents, run registry, shutdown evidence).
.solaris_ai_nn_ops/
.solaris_ai_nn_runs/

# Governance output (audit, approval records, operator sessions, risk
# assessments, checklists, reviews, generated runbooks). Local research
# records; regenerate per run. Commit a runbook only deliberately, under
# docs/templates.
.solaris_ai_nn_governance/

